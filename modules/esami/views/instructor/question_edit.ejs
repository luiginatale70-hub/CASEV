<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<div class="bg-white border rounded-3 shadow-sm p-4 mb-3">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      <h1 class="h5 mb-0"><%= mode === 'edit' ? 'Modifica domanda' : 'Nuova domanda' %></h1>
      <div class="text-muted small">Questionario: <strong><%= bank.exam_type %></strong> (ID <%= bank.id %>)</div>
    </div>

    <a class="btn-casev btn-casev-secondary"
       href="/esami/instructor/questions/<%= bank.id %>">
       ← Torna al questionario
    </a>
  </div>
</div>

<div class="bg-white border rounded-3 shadow-sm p-4">
  <form method="post"
        action="<%= mode === 'edit'
          ? '/esami/instructor/questions/' + bank.id + '/q/' + q.id + '/edit'
          : '/esami/instructor/questions/' + bank.id + '/add' %>">

    <div class="mb-3">
      <label class="form-label fw-600">Argomento</label>
      <input type="text" name="topic" class="form-control"
             value="<%= q.topic || '' %>" list="topics-list">
      <datalist id="topics-list">
        <% topics.forEach(function(t){ %>
          <option value="<%= t %>">
        <% }) %>
      </datalist>
    </div>

    <div class="mb-3">
      <label class="form-label fw-600">Domanda</label>
      <textarea name="question" class="form-control" rows="3" required><%= q.question || '' %></textarea>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-md-6"><input type="text" name="opt_a" class="form-control" required value="<%= q.opt_a || '' %>"></div>
      <div class="col-md-6"><input type="text" name="opt_b" class="form-control" required value="<%= q.opt_b || '' %>"></div>
      <div class="col-md-6"><input type="text" name="opt_c" class="form-control" required value="<%= q.opt_c || '' %>"></div>
      <div class="col-md-6"><input type="text" name="opt_d" class="form-control" value="<%= q.opt_d || '' %>"></div>
    </div>

    <div class="mb-4">
      <% ['A','B','C','D'].forEach(function(k){ %>
        <label class="me-3">
          <input type="radio" name="correct_key" value="<%= k %>" <%= (q.correct_key === k)?'checked':'' %>> <%= k %>
        </label>
      <% }) %>
    </div>

    <div class="d-flex gap-2">
      <button type="submit" class="btn-casev btn-casev-primary">
        <%= mode === 'edit' ? '💾 Salva modifiche' : '➕ Aggiungi domanda' %>
      </button>

      <a href="/esami/instructor/questions/<%= bank.id %>"
         class="btn-casev btn-casev-secondary">
         Annulla
      </a>
    </div>
  </form>
</div>

<%- include('../partials/foot') %>