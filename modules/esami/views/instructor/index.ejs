<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<body style="margin:0; min-height:100vh; display:flex; flex-direction:column;">



<div style="flex:1; padding:20px 25px; width:100%;">

  <div class="naaf-pagehead d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
      <h1 class="naaf-page-title mb-1">Area Istruttore</h1>
      <p class="mb-0" style="color:rgba(255,255,255,.62); font-size:1.2rem;">
        Import domande, assegnazione esami e report PDF per auditing.
      </p>
    </div>
    <div style="font-size:2rem; opacity:.35;">✈️</div>
  </div>

  <div class="row g-3 align-items-stretch" style="margin-top:10px;">

    <!-- IMPORT -->
    <div class="col-md-6 d-flex">
      <div class="card naaf-card-accent w-100">
        <div class="card-body d-flex flex-column" style="min-height:230px;">

          <div style="font-size:2rem; margin-bottom:1rem;">📥</div>
          <h5 class="fw-bold mb-2">Import Domande</h5>

          <p class="text-muted" style="font-size:1rem;">
            Carica un file Excel e associa le domande a una tipologia di esame.
          </p>

<div style="margin-top:auto; display:flex; justify-content:center;">
  <a href="/esami/instructor/questions/import" class="btn btn-primary">
    Importa
  </a>
</div>
             

        </div>
      </div>
    </div>

    <!-- ASSEGNA -->
    <div class="col-md-6 d-flex">
      <div class="card naaf-card-accent w-100">
        <div class="card-body d-flex flex-column" style="min-height:230px;">

          <div style="font-size:2rem; margin-bottom:1rem;">📝</div>
          <h5 class="fw-bold mb-2">Assegna Esame</h5>

          <p class="text-muted" style="font-size:1rem;">
            Seleziona allievo, tipologia, numero domande e argomenti facoltativi.
          </p>

       <div style="margin-top:auto; display:flex; justify-content:center;">
  <a href="/esami/instructor/exams/assign" class="btn btn-primary">
    Assegna esame
  </a>
</div>

  

        </div>
      </div>
    </div>

    <!-- ELENCO -->
    <div class="col-md-6 d-flex">
      <div class="card naaf-card-accent w-100">
        <div class="card-body d-flex flex-column" style="min-height:230px;">

          <div style="font-size:2rem; margin-bottom:1rem;">📋</div>
          <h5 class="fw-bold mb-2">Elenco Esami</h5>

          <p class="text-muted" style="font-size:1rem;">
            Elenco esami assegnati/svolti (20 per pagina) con link report PDF.
          </p>

       <div style="margin-top:auto; display:flex; justify-content:center;">
  <a href="/esami/instructor/exams" class="btn btn-primary">
    Apri esami
  </a>
</div>

        </div>
      </div>
    </div>

    <!-- QUESTIONARI -->
    <div class="col-md-6 d-flex">
      <div class="card naaf-card-accent w-100">
        <div class="card-body d-flex flex-column" style="min-height:230px;">

          <div style="font-size:2rem; margin-bottom:.75rem;">📚</div>
          <h5 class="fw-bold mb-2">Questionari</h5>

          <p class="text-muted" style="font-size:1rem;">
            Gestione questionari.
          </p>

       <div style="margin-top:auto; display:flex; justify-content:center;">
  <a href="/esami/instructor/questions" class="btn btn-primary">
    Apri questionari
  </a>
</div>

        </div>
      </div>
    </div>

  </div>

</div>

<!-- FOOTER -->
<div style="margin-top:auto;">
  <div class="naaf-footer">
    Portale NAAF &copy; <%= new Date().getFullYear() %>
  </div>
</div>

<%- include('../partials/foot') %>
</body>