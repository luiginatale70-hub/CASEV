<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<style>
.naaf-header {
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:16px;
}

.naaf-title {
  font-size:1.25rem;
  font-weight:600;
}

.naaf-subtitle {
  font-size:0.85rem;
  color:#6c757d;
}

.naaf-card {
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:12px;
  padding:14px;
}

.naaf-table td {
  padding-top:10px;
  padding-bottom:10px;
}

.naaf-type a {
  font-weight:600;
  text-decoration:none;
}

.naaf-type a:hover {
  text-decoration:underline;
}

.naaf-badge {
  border-radius:999px;
  padding:4px 10px;
  font-size:0.75rem;
}

.naaf-empty {
  text-align:center;
  padding:30px;
  color:#6c757d;
}
</style>

<div class="naaf-header">
  <div>
    <div class="naaf-title">Domande</div>
    <div class="naaf-subtitle">Gestione questionari importati</div>
  </div>

  <% if (user && user.role === 'admin') { %>
    <a class="btn btn-primary" href="/esami/instructor/questions/import">
      ➕ Importa Excel
    </a>
  <% } %>
</div>

<div class="naaf-card">

  <% if (!banks.length) { %>
    <div class="naaf-empty">
      <div class="mb-2">Nessun questionario presente</div>
      <% if (user && user.role === 'admin') { %>
        <a class="btn btn-sm btn-primary" href="/esami/instructor/questions/import">
          Importa il primo Excel
        </a>
      <% } %>
    </div>
  <% } else { %>

  <div class="table-responsive">
    <table class="table table-sm align-middle mb-0 naaf-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Tipologia</th>
          <th>Domande</th>
          <th>Creata</th>
          <% if (user && user.role === 'admin') { %>
          <th class="text-end">Azioni</th>
          <% } %>
        </tr>
      </thead>

      <tbody>
        <% banks.forEach(b => { %>
          <tr>
            <td class="text-muted"><%= b.id %></td>

            <td class="naaf-type">
              <a href="/esami/instructor/questions/<%= b.id %>">
                <%= b.exam_type %>
              </a>
            </td>

            <td>
              <span class="badge bg-primary naaf-badge">
                <%= b.qcount %> domande
              </span>
            </td>

            <td class="text-muted">
              <%= b.created_at %>
            </td>

            <% if (user && user.role === 'admin') { %>
            <td class="text-end">
              <form class="d-inline" method="post"
                    action="/esami/instructor/questions/<%= b.id %>/delete"
                    onsubmit="return confirm('Eliminare questo questionario e tutte le domande?')">
                <button class="btn btn-sm btn-outline-danger">
                  Elimina
                </button>
              </form>
            </td>
            <% } %>

          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% } %>

  <div class="mt-3">
    <a class="btn btn-link" href="/esami/instructor">Torna indietro</a>
  </div>

</div>

<%- include('../partials/foot') %>