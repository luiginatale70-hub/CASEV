<aside class="sidebar">
<div class="sidebar-header" style="display:flex;flex-direction:column;align-items:center;">
  
<div class="logo-area" style="display:flex;align-items:center;justify-content:center;">
  <img src="/img/Logo-naaf.png" style="width:100px;height:100px;object-fit:contain;border-radius:10px;" alt="CASEV">
</div>
<div class="logo-area" style="display:flex;align-items:center;justify-content:center;margin-bottom:12px;"></div>
    <div class="sidebar-badge">CASEV INTRANET</div>
  </div>

  <nav class="sidebar-nav">

    <!-- PRINCIPALE -->
    <div class="nav-section">
      <div class="nav-section-label">Principale</div>

      <a href="/" class="nav-item {{#if (eq currentPath "/")}}active{{/if}}">
        <span class="nav-icon">🏠</span> Home
      </a>

      <a href="/news" class="nav-item {{#if (startsWith currentPath "/news")}}active{{/if}}">
        <span class="nav-icon">📰</span> News & Comunicati
      </a>

      <a href="/pubblicazioni" class="nav-item {{#if (startsWith currentPath "/pubblicazioni")}}active{{/if}}">
        <span class="nav-icon">📚</span> Pubblicazioni
      </a>

      <a href="/manuali" class="nav-item {{#if (startsWith currentPath "/manuali")}}active{{/if}}">
        <span class="nav-icon">📚</span> Manualistica
      </a>
    </div>

    {{#if user}}
    <div class="nav-section">
      <div class="nav-section-label">Applicazioni</div>

      <!-- ✅ ESAMI SISTEMATO -->
    <a href="{{esamiUrl}}"
   class="nav-item {{#if (startsWith currentPath "/esami")}}active{{/if}}">
  <span class="nav-icon">📝</span> Esami On-Line
</a>

      {{#if isGestore}}
      <a href="/archivio" class="nav-item {{#if (startsWith currentPath "/archivio")}}active{{/if}}">
        <span class="nav-icon">🗄️</span> Archivio Documenti
      </a>


      {{/if}}
    </div>

    {{#if isAdmin}}
    <div class="nav-section">
      <div class="nav-section-label">Amministrazione</div>

      <a href="/admin" class="nav-item {{#if (startsWith currentPath "/admin")}}active{{/if}}">
        <span class="nav-icon">📊</span> Dashboard Admin
      </a>

      <a href="/admin/utenti" class="nav-item {{#if (startsWith currentPath "/admin/utenti")}}active{{/if}}">
        <span class="nav-icon">⚙️</span> Gestione Utenti
      </a>


    </div>
    {{/if}}
    {{/if}}

  </nav>

  <div class="sidebar-footer">
    {{#if user}}
    <div class="user-card">
      <div class="user-avatar">{{user.nome.[0]}}{{user.cognome.[0]}}</div>
      <div class="user-info">
        <div class="user-name">{{user.cognome}} {{user.nome}}</div>
        <div class="user-role">{{user.ruolo}}</div>
      </div>
      <a href="/auth/logout" class="logout-btn" title="Esci"
         style="background:#e63757;color:#fff;border-radius:6px;padding:6px 10px;font-size:13px;font-weight:600;text-decoration:none;">
        ⏻ Esci
      </a>
    </div>
    {{else}}
    <a href="/auth/login" class="btn btn-outline-light w100">🔑 Accedi</a>
    {{/if}}
  </div>
</aside>